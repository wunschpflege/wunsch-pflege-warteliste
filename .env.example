# ============================================================
#  Wunsch-Pflege GmbH - Wartelistenverwaltung
#  Umgebungsvariablen
# ============================================================

# PostgreSQL-Verbindung.
DATABASE_URL="postgresql://user:password@localhost:5432/wunschpflege?schema=public"

# Geheimer Schluessel fuer die Signierung der Login-Sessions (JWT).
AUTH_SECRET="bitte-einen-langen-zufaelligen-wert-eintragen-min-32-zeichen"

# Gueltigkeitsdauer der Session in Stunden (Standard 8)
SESSION_TTL_HOURS="8"

# Automatische Abmeldung nach so vielen Minuten ohne Eingabe (Standard 15). Erlaubt: 0.1 bis 240,
# auch mit Komma/Punkt (kleine Werte nur zum Testen); alles andere = 15. Gilt serverseitig pro
# Anmeldung; es gilt jeweils die kuerzere Frist aus INAKTIV_MINUTEN und SESSION_TTL_HOURS.
INAKTIV_MINUTEN="15"

# PIN des initialen Admin-Accounts (s.admin). NACH dem ersten Login aendern!
SEED_ADMIN_PIN="0000"

# Optional: Demo-/Testdaten beim Seed mit anlegen (true/false)
SEED_DEMO_DATA="true"

# Optional: Anbindung an das Wunsch-Pflege Portal (automatische Anmeldung + Kennzahlen).
# Gemeinsames Geheimnis, mindestens 32 Zeichen; im Portal als APP_WARTELISTE_SECRET eintragen.
# Leer oder kuerzer = Anbindung aus (/api/portal/* antwortet mit 404).
PORTAL_SECRET=""

# Optional: Anmeldung nur noch ueber das Portal. Adresse des Portals (https://..., lokal auch
# http://localhost:PORT). Ist sie gesetzt UND PORTAL_SECRET gueltig, ist die PIN-Anmeldung der
# Warteliste abgeschaltet (Anmeldeseite zeigt "Über das Portal anmelden", /api/auth/login antwortet 403).
# Leer oder ungueltig = Anmeldung wie bisher. Zurueckschalten: Variable loeschen und neu starten.
PORTAL_ANMELDUNG_URL=""

# Wird von Railway automatisch gesetzt
PORT="3000"
NODE_ENV="production"
